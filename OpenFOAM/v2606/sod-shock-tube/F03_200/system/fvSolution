FoamFile
{
 version 2.0;
 format ascii;
 class dictionary;
 object fvSolution;
}

solvers
{
    "(rho|rhoU|rhoE)" { solver diagonal; }
    U { solver smoothSolver; smoother GaussSeidel; tolerance 1e-9; relTol 0.01; nSweeps 2; }
    h { solver smoothSolver; smoother GaussSeidel; tolerance 1e-10; relTol 0; nSweeps 2; }
}

