Header
  Mesh DB "." "mesh"
End

Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Intervals(1) = 32
  Timestep Sizes(1) = 1.0
  Output Intervals(1) = 4
  Max Output Level = 4
End

Constants
  Stefan Boltzmann = 5.67e-8
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End

Equation 1
  Active Solvers(2) = 1 2
End

Initial Condition 1
  Temperature = 0
End

Material 1
  Heat Conductivity = 35
  Density = 7200
  Heat Capacity = 440.5
End

Solver 1
  Equation = "Heat Equation"
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Nonlinear System Max Iterations = 30
  Nonlinear System Convergence Tolerance = 1e-10
  Linear System Solver = Direct
  Linear System Direct Method = umfpack
  Linear System Convergence Tolerance = 1e-10
End

Solver 2
  Equation = "Output"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "case"
  Vtu Format = True
  Binary Output = False
  Single Precision = False
  Exec Solver = After Saving
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Temperature = 0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  Temperature = Variable Time
    Real MATC "100*sin(pi*tx/40)"
End
