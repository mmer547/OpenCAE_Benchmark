Header
  Mesh DB "." "mesh"
End

Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Max Output Level = 4
End

Constants
  Stefan Boltzmann = 5.67e-8
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
  Body Force = 1
End

Equation 1
  Active Solvers(2) = 1 2
End

Body Force 1
  Body Force 3 = -360
End

Material 1
  Youngs Modulus = 4.32E8
  Poisson Ratio = 0
  Density = 11.18915894822
  Thickness = 0.25
End

Solver 1
  Equation = "Facet shell"
  Procedure = "FacetShellSolve" "ShellSolver"
  Variable = -dofs 6 Deflection
  Large Deflection = False
  Displace Mesh = False
  Nonlinear System Max Iterations = 2
  Nonlinear System Convergence Tolerance = 1e-8
  Linear System Solver = Direct
  Linear System Direct Method = umfpack
  Linear System Convergence Tolerance = 1e-10
End

Solver 2
  Equation = "Output"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "case"
  Vtu Format = True
  Binary Output = False
  Single Precision = False
  Scalar Field 1 = "Deflection 3"
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Deflection 1 = 0
  Deflection 3 = 0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  Deflection 2 = 0
End
