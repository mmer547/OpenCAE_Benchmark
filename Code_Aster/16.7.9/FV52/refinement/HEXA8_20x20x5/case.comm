DEBUT(LANG='EN')
mesh=LIRE_MAILLAGE(UNITE=20,FORMAT='ASTER')
model=AFFE_MODELE(MAILLAGE=mesh,AFFE=_F(TOUT='OUI',PHENOMENE='MECANIQUE',MODELISATION='3D'))
mat=DEFI_MATERIAU(ELAS=_F(E=200000000000.0,NU=0.3,RHO=8000))
field=AFFE_MATERIAU(MAILLAGE=mesh,AFFE=_F(TOUT='OUI',MATER=mat))
fix=AFFE_CHAR_CINE(MODELE=model,MECA_IMPO=(_F(GROUP_NO='G0',DZ=0.),))
ASSEMBLAGE(MODELE=model,CHAM_MATER=field,CHAR_CINE=fix,NUME_DDL=CO('nddl'),MATR_ASSE=(_F(MATRICE=CO('stiff'),OPTION='RIGI_MECA'),_F(MATRICE=CO('mass'),OPTION='MASS_MECA')))
res=CALC_MODES(MATR_RIGI=stiff,MATR_MASS=mass,OPTION='CENTRE',CALC_FREQ=_F(FREQ=3.,NMAX_FREQ=16,SEUIL_FREQ=.5),VERI_MODE=_F(STOP_ERREUR='OUI',PREC_SHIFT=.0001))
tab=POST_RELEVE_T(ACTION=_F(INTITULE='extract',OPERATION='EXTRACTION',RESULTAT=res,NOM_CHAM='DEPL',GROUP_NO='TRACK',NOM_CMP=('DX','DY','DZ')))
import json
with open('fort.82','w') as h:
    json.dump(tab.EXTR_TABLE().values(),h)
IMPR_RESU(FORMAT='MED',UNITE=80,RESU=_F(RESULTAT=res,NOM_CHAM=('DEPL',)))
FIN()
