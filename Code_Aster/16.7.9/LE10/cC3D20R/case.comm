DEBUT(LANG='EN')
mesh=LIRE_MAILLAGE(UNITE=20,FORMAT='ASTER')
model=AFFE_MODELE(MAILLAGE=mesh,AFFE=_F(TOUT='OUI',PHENOMENE='MECANIQUE',MODELISATION='3D_SI'))
mat=DEFI_MATERIAU(ELAS=_F(E=210000000000.0,NU=0.3,RHO=0))
field=AFFE_MATERIAU(MAILLAGE=mesh,AFFE=_F(TOUT='OUI',MATER=mat))
fix=AFFE_CHAR_CINE(MODELE=model,MECA_IMPO=(_F(GROUP_NO='G0',DY=0.),_F(GROUP_NO='G1',DX=0.),_F(GROUP_NO='G2',DX=0.),_F(GROUP_NO='G2',DY=0.),_F(GROUP_NO='G3',DZ=0.),))
load=AFFE_CHAR_MECA(MODELE=model,FORCE_FACE=_F(GROUP_MA='LOADED',FZ=-1.e6))
res=MECA_STATIQUE(MODELE=model,CHAM_MATER=field,EXCIT=(_F(CHARGE=fix),_F(CHARGE=load)))
res=CALC_CHAMP(reuse=res,RESULTAT=res,CONTRAINTE=('SIGM_NOEU',))
tab=POST_RELEVE_T(ACTION=_F(INTITULE='extract',OPERATION='EXTRACTION',RESULTAT=res,NOM_CHAM='SIGM_NOEU',GROUP_NO='PROBE',NOM_CMP='SIYY'))
import json
with open('fort.82','w') as h:
    json.dump(tab.EXTR_TABLE().values(),h)
IMPR_RESU(FORMAT='MED',UNITE=80,RESU=_F(RESULTAT=res,NOM_CHAM=('DEPL', 'SIGM_NOEU')))
FIN()
