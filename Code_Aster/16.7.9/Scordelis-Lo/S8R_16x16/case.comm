DEBUT(LANG='EN')
mesh=LIRE_MAILLAGE(UNITE=20,FORMAT='ASTER')
mesh9=CREA_MAILLAGE(MAILLAGE=mesh, MODI_MAILLE=_F(OPTION='QUAD8_9',TOUT='OUI'))
model=AFFE_MODELE(MAILLAGE=mesh9,AFFE=_F(TOUT='OUI',PHENOMENE='MECANIQUE',MODELISATION='COQUE_3D'))
mat=DEFI_MATERIAU(ELAS=_F(E=432000000.0,NU=0,RHO=11.18915894821906))
field=AFFE_MATERIAU(MAILLAGE=mesh9,AFFE=_F(TOUT='OUI',MATER=mat))
shell=AFFE_CARA_ELEM(MODELE=model,COQUE=_F(GROUP_MA='BODY',EPAIS=.25,VECTEUR=(0.,1.,0.)))
fix=AFFE_CHAR_CINE(MODELE=model,MECA_IMPO=(_F(GROUP_NO='G0',DX=0.),_F(GROUP_NO='G0',DZ=0.),_F(GROUP_NO='G1',DY=0.),))
load=AFFE_CHAR_MECA(MODELE=model,PESANTEUR=_F(GRAVITE=32.174,DIRECTION=(0.,0.,-1.)))
res=MECA_STATIQUE(MODELE=model,CHAM_MATER=field,CARA_ELEM=shell,EXCIT=(_F(CHARGE=fix),_F(CHARGE=load)))
tab=POST_RELEVE_T(ACTION=_F(INTITULE='extract',OPERATION='EXTRACTION',RESULTAT=res,NOM_CHAM='DEPL',GROUP_NO='PROBE',NOM_CMP='DZ'))
import json
with open('fort.82','w') as h:
    json.dump(tab.EXTR_TABLE().values(),h)
IMPR_RESU(FORMAT='MED',UNITE=80,RESU=_F(RESULTAT=res,NOM_CHAM=('DEPL',)))
FIN()
