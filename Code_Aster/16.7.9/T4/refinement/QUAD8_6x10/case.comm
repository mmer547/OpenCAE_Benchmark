DEBUT(LANG='EN')
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(TOUT='OUI', PHENOMENE='THERMIQUE', MODELISATION='PLAN'))
mat = DEFI_MATERIAU(THER=_F(LAMBDA=52.))
field = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(TOUT='OUI', MATER=mat))
hot = AFFE_CHAR_THER(MODELE=model, TEMP_IMPO=_F(GROUP_MA='BOTTOM', TEMP=100.))
air = AFFE_CHAR_THER(MODELE=model, ECHANGE=_F(GROUP_MA=('RIGHT','TOP'), COEF_H=750., TEMP_EXT=0.))
times = DEFI_LIST_REEL(VALE=(1.,))
res = THER_LINEAIRE(TYPE_CALCUL='STAT', INCREMENT=_F(LIST_INST=times), MODELE=model, CHAM_MATER=field, EXCIT=(_F(CHARGE=hot), _F(CHARGE=air)))
probe = POST_RELEVE_T(ACTION=_F(INTITULE='probe', OPERATION='EXTRACTION', RESULTAT=res,
                                NOM_CHAM='TEMP', GROUP_NO='PROBE', NOM_CMP='TEMP'))
import json
with open('fort.82','w') as output:
    json.dump(probe.EXTR_TABLE().values(), output)
IMPR_RESU(FORMAT='MED', UNITE=80, RESU=_F(RESULTAT=res, NOM_CHAM='TEMP'))
FIN()
