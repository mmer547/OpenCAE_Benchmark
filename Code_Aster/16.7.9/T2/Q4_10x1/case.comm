DEBUT(LANG='EN')
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(TOUT='OUI', PHENOMENE='THERMIQUE', MODELISATION='PLAN'))
conduct = DEFI_CONSTANTE(VALE=55.6)
enthalpy = DEFI_FONCTION(NOM_PARA='TEMP', VALE=(-273.15, 0., 1000., 1273.15*7850.*460.), PROL_GAUCHE='LINEAIRE', PROL_DROITE='LINEAIRE')
mat = DEFI_MATERIAU(THER_NL=_F(LAMBDA=conduct, BETA=enthalpy))
field = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(TOUT='OUI', MATER=mat))
hot = AFFE_CHAR_THER(MODELE=model, TEMP_IMPO=_F(GROUP_MA='LEFT', TEMP=726.85))
rad = AFFE_CHAR_THER(MODELE=model, RAYONNEMENT=_F(GROUP_MA='RIGHT', EPSILON=0.98, SIGMA=5.67e-8, TEMP_EXT=26.85))
times = DEFI_LIST_REEL(VALE=(1.,))
res = THER_NON_LINE(TYPE_CALCUL='STAT', INCREMENT=_F(LIST_INST=times), MODELE=model, CHAM_MATER=field,
                    EXCIT=(_F(CHARGE=hot), _F(CHARGE=rad)), NEWTON=_F(REAC_ITER=1), CONVERGENCE=_F(RESI_GLOB_RELA=1.e-10, ITER_GLOB_MAXI=50))
probe = POST_RELEVE_T(ACTION=_F(INTITULE='probe', OPERATION='EXTRACTION', RESULTAT=res,
                                NOM_CHAM='TEMP', GROUP_NO='PROBE', NOM_CMP='TEMP'))
import json
with open('fort.82','w') as output:
    json.dump(probe.EXTR_TABLE().values(), output)
IMPR_RESU(FORMAT='MED', UNITE=80, RESU=_F(RESULTAT=res, NOM_CHAM='TEMP'))
FIN()
